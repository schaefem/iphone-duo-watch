# Einstellungen für den iPhone-Duo-Wächter (wird von run.sh geladen)

# ntfy-Thema für die Push-Nachrichten (wird von install.sh abgefragt)
NTFY_TOPIC=

# --- Apple ---
# Stadt/Store-Filter: "Dresden", "Dresden,Berlin" oder "*" für alle Stores in Deutschland
STORE_FILTER="Dresden"
# Lebenszeichen alle X Stunden, wenn nichts gefunden wurde (0 = aus)
PING_HOURS=3

# --- MediaMarkt / Saturn ---
# Markt-IDs (mehrere mit Komma), 460 = dein MediaMarkt, 12 = dein Saturn
MEDIAMARKT_STORES=460
SATURN_STORES=12

# --- Cyberport ---
# Wie oft Cyberport geprüft wird (Minuten), 0 bei CYBERPORT = aus
CYBERPORT_EVERY_MIN=15
CYBERPORT=1

# Ausführliche Ausgaben im Log (1 = an)
DEBUG=0
